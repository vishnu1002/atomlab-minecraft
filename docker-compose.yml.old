services:

  mc1:
    image: itzg/minecraft-server:latest
    container_name: mc1
    profiles: ["mc1"]
    restart: unless-stopped
    tty: true
    stdin_open: true
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      VERSION: "26.1.2"
      MEMORY: "5G"
      DIFFICULTY: "normal"
      MODE: "survival"
      TZ: "UTC"
      USE_AIKAR_FLAGS: "true"
      SEED: "8500081009970950196"
      ENABLE_AUTOPAUSE: "false"
      ONLINE_MODE: "FALSE"
      MOTD: "MC1"
      SPAWN_PROTECTION: "0"
      MAX_TICK_TIME: "-1"
      VIEW_DISTANCE: "30"
      SIMULATION_DISTANCE: "20"
      CREATE_CONSOLE_IN_PIPE: "true"
      MODRINTH_PROJECTS_DEFAULT_VERSION_TYPE: "alpha"
      MODRINTH_LOADER: "fabric"
      MODRINTH_PROJECTS: |
        fabric-api
        cloth-config
        fabric-language-kotlin
        resourceful-lib
        yacl
        VSNURh3q:alpha
        chunky
        lithium
        ferrite-core
        xaeros-world-map
        xaeros-minimap
        veinminer
        skinrestorer
        universal-graves
        polymer
        mns-moogs-nether-structures
        moogs-voyager-structures
        moogs-structure-lib
        more-mobs
        dungeons-and-taverns
        friends-and-foes
        spawn-animations
        mine-treasure
        fallingtree
        glitchcore
        ping-wheel
    volumes: 
      - ./mc1:/data
      - /etc/localtime:/etc/localtime:ro
    expose: ["25565"]
    healthcheck:
      test: ["CMD", "mc-monitor", "status", "--host", "127.0.0.1"]
      interval: 45s
      timeout: 15s
      retries: 4
    networks:
      mc_network:
        ipv4_address: 172.30.0.5
  playit-mc1:
    image: ghcr.io/playit-cloud/playit-agent:0.17
    container_name: playit-mc1
    profiles: ["mc1"]
    restart: unless-stopped
    environment:
      SECRET_KEY: ${MC1_SECRET_KEY}
      TZ: "UTC"
    volumes:
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      mc1:
        condition: service_healthy
    network_mode: "service:mc1"

  mc2:
    image: itzg/minecraft-server:latest
    container_name: mc2
    profiles: ["mc2"]
    restart: unless-stopped
    tty: true
    stdin_open: true
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      VERSION: "LATEST"
      INIT_MEMORY: "1G"
      MAX_MEMORY: "2G"
      USE_AIKAR_FLAGS: "true"
      SEED: ""
      ONLINE_MODE: "FALSE"
      MOTD: "MC2"
    volumes: ["./mc2:/data"]
    expose: ["25565"]
    healthcheck:
      test: ["CMD", "mc-monitor", "status", "--host", "127.0.0.1"]
      interval: 45s
      timeout: 15s
      retries: 4
    networks:
      mc_network:
        ipv4_address: 172.30.0.6
  playit-mc2:
    image: ghcr.io/playit-cloud/playit-agent:0.17
    container_name: playit-mc2
    profiles: ["mc2"]
    restart: unless-stopped
    environment:
      SECRET_KEY: ${MC2_SECRET_KEY}
    depends_on:
      mc2:
        condition: service_healthy
    networks:
      mc_network:
        ipv4_address: 172.30.0.16

  mc3:
    image: itzg/minecraft-server:latest
    container_name: mc3
    profiles: ["mc3"]
    restart: unless-stopped
    tty: true
    stdin_open: true
    environment:
      EULA: "TRUE"
      TYPE: "FABRIC"
      VERSION: "LATEST"
      INIT_MEMORY: "1G"
      MAX_MEMORY: "2G"
      USE_AIKAR_FLAGS: "true"
      SEED: ""
      ONLINE_MODE: "FALSE"
      MOTD: "MC3"
    volumes: ["./mc3:/data"]
    expose: ["25565"]
    healthcheck:
      test: ["CMD", "mc-monitor", "status", "--host", "127.0.0.1"]
      interval: 45s
      timeout: 15s
      retries: 4
    networks:
      mc_network:
        ipv4_address: 172.30.0.7
  playit-mc3:
    image: ghcr.io/playit-cloud/playit-agent:0.17
    container_name: playit-mc3
    profiles: ["mc3"]
    restart: unless-stopped
    environment:
      SECRET_KEY: ${MC3_SECRET_KEY}
    depends_on:
      mc3:
        condition: service_healthy
    networks:
      mc_network:
        ipv4_address: 172.30.0.17

networks:
  mc_network:
    driver: bridge
    ipam:
      config:
        - subnet: 172.30.0.0/24